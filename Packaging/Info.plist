<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Hash D Island</string>
	<key>CFBundleDisplayName</key>
	<string>Hash D Island</string>
	<key>CFBundleIdentifier</key>
	<string>com.hashdisland.app</string>
	<key>CFBundleExecutable</key>
	<string>HashDIsland</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- Agent app: no Dock icon, no app-switcher entry, and no menu-bar item
	     either — the notch overlay is the whole interface. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Shown by macOS in the Automation permission prompt. Without this key,
	     hardened-runtime builds are denied Apple Events silently. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>HashDIsland asks your media apps for the current track and artwork — and, for web videos, asks your browser for the playing tab's address to show its thumbnail — so Now Playing can appear around the notch. Playback and volume are controlled only when you use the panel's buttons. Deny this and everything else still works.</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Seif Hashish. MIT License.</string>
</dict>
</plist>
